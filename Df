
FROM tomcat:9-jdk17

# Remove default Tomcat applications
RUN rm -rf /usr/local/tomcat/webapps/*

# Add PostgreSQL JDBC driver
RUN wget https://jdbc.postgresql.org/download/postgresql-42.6.0.jar -O /usr/local/tomcat/lib/postgresql-42.6.0.jar

# Add Redis client (Jedis) - can be replaced with your preferred Redis client
RUN wget https://repo1.maven.org/maven2/redis/clients/jedis/4.4.3/jedis-4.4.3.jar -O /usr/local/tomcat/lib/jedis-4.4.3.jar
RUN wget https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar -O /usr/local/tomcat/lib/commons-pool2-2.11.1.jar

# Optionally add a sample war file (replace with your actual WAR file)
COPY build/libs/ROOT.war /usr/local/tomcat/webapps/ROOT.war

# Set proper Tomcat configuration if needed
# COPY server.xml /usr/local/tomcat/conf/server.xml

EXPOSE 8080
CMD ["catalina.sh", "run"]